VITE_DEEPSEEK_MODEL=deepseek-chat
VITE_COACH_DEBUG=false
VITE_CLOUDBASE_ENV_ID=your-full-cloudbase-env-id
VITE_CLOUDBASE_REGION=ap-shanghai
VITE_CLOUDBASE_ACCESS_KEY=your-cloudbase-publishable-key
# 部署 auth-session HTTP 云函数后填写，例如 https://your-env.service.tcloudbase.com/auth-session
VITE_AUTH_API_BASE=

# 不要把 DeepSeek API Key 写在这里。
# 本地开发：登录后到「我 → 开发者工具」粘贴 Key。
# 生产：在 CloudBase 云函数 ai-complete 环境变量设置 DEEPSEEK_API_KEY。